rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId || isAdmin();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['suspended']));
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /leaderboard/{userId} {
      allow read: if resource.data.public == true;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['public', 'displayName', 'wpm', 'accuracy', 'updatedAt'])
        && request.resource.data.public == true
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.wpm is int
        && request.resource.data.wpm >= 0
        && request.resource.data.wpm <= 400
        && request.resource.data.accuracy is int
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100;
      allow delete: if (signedIn() && request.auth.uid == userId) || isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'category', 'message', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }
  }
}
